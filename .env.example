# =============================================================
# 【必須】どの設定でも必要
# =============================================================

# SVN リポジトリの URL（svn コマンドに渡す）
# 例:
#   Docker内のfile://パス: file:///svn-repo/my-repo
#   リモートSVNサーバ:     https://svn.example.com/repo
SVN_REPO_URL=file:///svn-repo/my-repo


# =============================================================
# 【svn の実行方式】Docker 経由 / ホスト直接 のどちらか
#   未設定なら true（Docker経由）
# =============================================================

#   true:  docker compose exec <service> svn ... で実行（ホストに svn 不要）
#   false: ホストの svn を直接実行（ホストに svn が必要）
SVN_USE_DOCKER=true

# --- SVN_USE_DOCKER=true の場合のみ必須 ---
# docker compose を実行するディレクトリ（compose.yml のあるパス）
SVN_COMPOSE_DIR=C:\path\to\your\docker-compose-dir

# --- SVN_USE_DOCKER=true の場合のみ使用（任意、既定: "svn"）---
# svn コマンドが入っているサービス名（compose のサービス名に合わせる）
#SVN_DOCKER_SERVICE=svn


# =============================================================
# 【任意】GUI で差分を見たい人だけ設定
#   未設定の場合、show_diff_external ツールが無効化されるだけで
#   他のツール（svn_info / svn_log / svn_diff など）はすべて動作する
# =============================================================

# 外部差分ツール（WinMerge 等）のフルパス
#SVN_EXTERNAL_DIFF_TOOL=C:\Program Files\WinMerge\WinMergeU.exe


# =============================================================
# 【任意】TortoiseSVN で目視確認したい人だけ設定
#   未設定の場合、show_log_tortoise ツールが無効化されるだけで
#   他のツールはすべて動作する
# =============================================================

# TortoiseProc.exe のフルパス
#SVN_TORTOISE_PROC=C:\Program Files\TortoiseSVN\bin\TortoiseProc.exe

# TortoiseSVN から見たリポジトリのベース URL（または作業コピーの絶対パス）。
# 未設定なら SVN_REPO_URL をそのまま使う。
# SVN_REPO_URL が Docker 内 file:// パスの場合、Windows ホスト側 TortoiseSVN からは
# 見えないため、ここで Windows から到達可能な URL/パスを別途指定する必要がある。
# 例: SVN_REPO_URL_CLIENT=https://svn.example.com/repo
# 例: SVN_REPO_URL_CLIENT=C:\path\to\working-copy
#SVN_REPO_URL_CLIENT=


# =============================================================
# 【任意】Windows エクスプローラで開くなら設定
#   未設定の場合、open_in_explorer ツールが無効化されるだけで
#   他のツールはすべて動作する
# =============================================================

# 作業コピー（ローカル WC）の絶対パス。
# ファイル指定なら /select で親フォルダを開いてファイル選択、
# フォルダ指定ならそのフォルダを開く。
#SVN_WORKING_COPY=C:\path\to\working-copy


# =============================================================
# 【任意】既定値を変えたい場合のみ設定
# =============================================================

# svn コマンドのタイムアウト（ミリ秒、既定: 30000）
#SVN_TIMEOUT_MS=30000
